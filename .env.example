# Postgres. Local dev uses the docker-compose Postgres; in production use Neon.
# Neon connection strings already include ?sslmode=require — no custom CA cert needed.
# Example (Neon): postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/guit_strum?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/guit_strum?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-your-own-with-node-crypto-randomBytes

# Recognizer WebSocket base URL (no trailing /ws/recognize).
# Local:      ws://127.0.0.1:8000
# Production: wss://<your-space-name>.hf.space   (must be wss:// — the app runs over HTTPS)
NEXT_PUBLIC_RECOGNIZER_WS_URL=ws://127.0.0.1:8000
